        "type": "number",
        "description": "Base price per unit"
      },
      "unit": {
        "type": "string",
        "description": "Unit of measurement (sqft, sheet, sqm)"
      },
      "life": {
        "type": "number",
        "description": "Expected lifespan in years"
      },
      "warranty": {
        "type": "number",
        "description": "Warranty period in years"
      },
      "finish": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Available finishes"
      },
      "maintenance": {
        "type": "string",
        "description": "Maintenance requirements"
      },
      "description": {
        "type": "string",
        "description": "Detailed description"
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Tags for categorization"
      },
      "availability": {
        "type": "string",
        "description": "Availability status (in_stock, limited, made_to_order)"
      }
    }
  },
