      },
      "basic": {
        "type": "object",
        "description": "Basic tier specifications",
        "properties": {
          "price": { "type": "number" },
          "thickness": { "type": "string" },
          "grade": { "type": "string" }
        }
      },
      "medium": {
        "type": "object",
